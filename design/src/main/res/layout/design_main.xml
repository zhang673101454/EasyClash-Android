<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data>
        <variable
            name="self"
            type="com.github.kr328.clash.design.MainDesign" />
        <variable
            name="clashRunning"
            type="boolean" />
        <variable
            name="forwarded"
            type="String" />
        <variable
            name="mode"
            type="String" />
        <variable
            name="profileName"
            type="String" />
        <variable
            name="colorClashStarted"
            type="int" />
        <variable
            name="colorClashStopped"
            type="int" />
        <variable
            name="hasProviders"
            type="boolean" />
        <variable
            name="homeTab"
            type="boolean" />

        <import type="android.view.View" />
        <import type="com.github.kr328.clash.design.MainDesign.Request" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:paddingStart="@{self.surface.insets.start}"
        android:paddingEnd="@{self.surface.insets.end}">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="@{self.surface.insets.top}"
            android:paddingBottom="@{self.surface.insets.bottom}">

            <!-- TitleBar：Logo + 名 + 状态点 + 智能模式 · 右上角仅 + -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/application_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/easyclash_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/application_name"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginStart="8dp"
                            android:background="@{clashRunning ? @drawable/bg_ec_dot_on : @drawable/bg_ec_dot_off}" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{mode}"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/_new"
                    android:onClick="@{() -> self.request(Request.OpenNewProfile)}"
                    android:padding="8dp"
                    android:src="@drawable/ic_baseline_add" />
            </LinearLayout>

            <!-- Tab：连接 | 节点 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_ec_picker"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@{homeTab ? @drawable/bg_ec_picker_active : null}"
                    android:gravity="center"
                    android:onClick="@{() -> self.request(Request.ShowHome)}"
                    android:text="@string/tab_connect"
                    android:textColor="@{homeTab ? @color/color_clash_light : ?android:attr/textColorSecondary}"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@{homeTab ? null : @drawable/bg_ec_picker_active}"
                    android:gravity="center"
                    android:onClick="@{() -> self.request(Request.OpenProxy)}"
                    android:text="@string/tab_nodes"
                    android:textColor="@{homeTab ? ?android:attr/textColorSecondary : @color/color_clash_light}"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 主体：进订阅列表（额度在各订阅卡上） -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:onClick="@{() -> self.request(Request.OpenProfiles)}">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:background="@{clashRunning ? @drawable/bg_ec_card_active : @drawable/bg_ec_card}"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@{profileName != null ? profileName : @string/not_selected}"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@{clashRunning ? @drawable/bg_ec_badge_on : @drawable/bg_ec_badge_off}"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="@{clashRunning ? @string/badge_in_use : @string/badge_idle}"
                            android:textColor="@{clashRunning ? @color/color_clash_light : ?android:attr/textColorSecondary}"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/subscription_card_hint"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
